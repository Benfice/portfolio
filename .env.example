# Sanity CMS (optionnel : sans ces variables, le site utilise le snapshot
# committé dans sanity/snapshot.json — idéal pour les builds hors ligne).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Jetons côté serveur (jamais diffusés au client).
SANITY_API_READ_TOKEN=
# Uniquement nécessaire pour `npm run seed:sanity` (mise à jour du dataset).
SANITY_API_WRITE_TOKEN=

# URL publique du site (canonical, Open Graph, sitemap). À définir en production
# (ex. https://benoitfreulon.vercel.app). Si absente sur Vercel, elle est déduite
# de VERCEL_PROJECT_PRODUCTION_URL (domaine stable) puis de VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Vérification des moteurs de recherche (balises meta). Renseigner les jetons
# fournis par Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form (Resend). Si RESEND_API_KEY est absent, le formulaire peut
# toujours utiliser mailto comme secours.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
